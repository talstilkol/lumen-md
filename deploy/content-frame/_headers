# The content frame's own site (plan W6.40): https://lumen-md-frame.pages.dev/,
# a Cloudflare Pages project deployed by Direct Upload
# (scripts/content-frame-site.mjs). It holds only the frame's page (as
# index.html, so Cloudflare serves it at / without its .html → extension-less
# redirect) and its script, so the frame never has the app's origin.
#
# The policy values come from security/policy.json (host content-frame-site):
# edit that file and run `npm run headers:write`.

/*
  X-Content-Type-Options: nosniff
  Content-Security-Policy: default-src 'none'; script-src 'self' 'nonce-lumen-livejs-runner' https://gist.github.com; style-src 'self' 'unsafe-inline' https://github.githubassets.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com https://www.loom.com https://codepen.io https://codesandbox.io https://www.figma.com https://open.spotify.com https://www.google.com https://maps.google.com https://www.openstreetmap.org https://platform.twitter.com https://www.facebook.com https://www.instagram.com https://www.tiktok.com https://www.redditmedia.com https://www.reddit.com https://www.linkedin.com https://w.soundcloud.com; connect-src 'none'; frame-ancestors https://lumen-md.vercel.app https://lumen-md.pages.dev tauri://localhost http://tauri.localhost capacitor://localhost https://localhost; base-uri 'none'; form-action 'none'
