{
  "appId": "com.lumen.editor",
  "appName": "Lumen",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0c0f17",
      "showSpinner": false,
      "androidSpinnerStyle": "small",
      "spinnerColor": "#7c5cff"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0c0f17"
    },
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": true
    }
  },
  "ios": {
    "contentInset": "automatic",
    "allowsLinkPreview": true,
    "scrollEnabled": true
  },
  "android": {
    "allowMixedContent": true
  }
}
