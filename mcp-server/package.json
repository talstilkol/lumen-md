{
  "name": "@lumen-md/mcp-server",
  "version": "0.2.0",
  "description": "The Lumen vault for MCP clients (Claude Desktop, Claude Code, Cursor, VS Code) and a `lumen` CLI — off by default, scopes per client, writes only after your approval.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "lumen-mcp": "./dist/index.js",
    "lumen": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "test:stdio": "npm run build && node test/stdio-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "markdown",
    "lumen",
    "claude",
    "cursor"
  ]
}
