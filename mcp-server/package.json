{
  "name": "@lumen-md/mcp-server",
  "version": "0.1.0",
  "description": "Model Context Protocol server that exposes a Lumen workspace to AI agents (Claude Desktop, Cursor, etc).",
  "license": "MIT",
  "type": "module",
  "bin": {
    "lumen-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": ["mcp", "model-context-protocol", "markdown", "lumen", "claude", "cursor"]
}
