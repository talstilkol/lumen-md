# Cloudflare Pages security headers
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com https://cdn.tldraw.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' blob: data: ws: wss: https://api.openai.com https://api.anthropic.com https://generativelanguage.googleapis.com https://api.mistral.ai http://localhost:11434 http://127.0.0.1:11434 http://localhost:8787 http://127.0.0.1:8787 http://localhost:8010 http://127.0.0.1:8010 https://api.languagetool.org https://kroki.io https://oauth2.googleapis.com https://www.googleapis.com https://api.dropboxapi.com https://content.dropboxapi.com https://github.com https://api.github.com https://huggingface.co https://*.huggingface.co https://cdn-lfs.huggingface.co https://*.hf.co https://raw.githubusercontent.com https://cdn.tldraw.com https://www.gstatic.com https://fonts.googleapis.com https://fonts.gstatic.com https://*.supabase.co https://*.sentry.io; worker-src 'self' blob:; frame-src 'self' data: https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com https://www.loom.com https://codepen.io https://codesandbox.io https://www.figma.com https://open.spotify.com https://www.google.com https://maps.google.com https://www.openstreetmap.org https://platform.twitter.com https://www.facebook.com https://www.instagram.com https://www.tiktok.com https://www.redditmedia.com https://www.reddit.com https://www.linkedin.com https://gist.github.com https://w.soundcloud.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; require-trusted-types-for 'script'; trusted-types lumen default dompurify lit-html iconify ProseMirrorClipboard 'allow-duplicates'
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=(), geolocation=(self), microphone=(self), camera=(self)

# Web Playground runner: the page inside the playground block's sandboxed
# iframe (`sandbox="allow-scripts"`, opaque origin — it can't reach the app's
# storage or DOM). It runs the user's own project code, so it gets its own
# policy instead of the app's: blob: modules (the linked project files) and
# eval (Vue's template compiler), no Trusted Types, framing by the app only.
/playground-runner.html
  ! Content-Security-Policy
  ! X-Frame-Options
  Content-Security-Policy: default-src 'none'; script-src 'self' blob: 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src * data: blob:; media-src * data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'none'; form-action 'none'

# live-js runner (T48): the hidden iframe live-js code runs in
# (`sandbox="allow-scripts"`, opaque origin: no IndexedDB, localStorage,
# OPFS, cookies or tokens of the app). The user's code runs in a blob: worker
# that inherits this policy: eval for the code itself, and no network at all.
/livejs-runner.html
  ! Content-Security-Policy
  ! X-Frame-Options
  Content-Security-Policy: default-src 'none'; script-src 'self' 'nonce-lumen-livejs-runner' blob: 'unsafe-eval'; worker-src blob:; connect-src 'none'; img-src 'none'; style-src 'none'; frame-ancestors 'self'; base-uri 'none'; form-action 'none'

# On-device OCR (T31): the tesseract.js worker, its wasm cores and the language
# models (tesseract/lang/, same origin since plan 7.5). Dedicated workers get
# their own policy from their response; the app's Trusted Types requirement
# would block the worker's own importScripts() of the core.
/tesseract/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self'; worker-src 'self' blob:; base-uri 'none'; form-action 'none'

# Workers that need eval (F4 / P3): Graphviz (Emscripten embind builds its
# bindings with new Function), ruby.wasm and the TypeScript checker. A
# worker takes the CSP of its own script response, so eval is granted to
# these scripts only — the page itself allows none.
/assets/graphviz.worker-*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; connect-src 'self' blob: data:; worker-src 'self' blob:; object-src 'none'; base-uri 'none'
/assets/ruby.worker-*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; connect-src 'self' blob: data:; worker-src 'self' blob:; object-src 'none'; base-uri 'none'
/assets/tsCheck.worker-*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; connect-src 'self' blob: data:; worker-src 'self' blob:; object-src 'none'; base-uri 'none'

# The runner's opaque origin ("null") loads its own module chunks and Vue's
# ESM build with CORS: allow any origin to read these public, static,
# credential-free files.
/assets/*
  Access-Control-Allow-Origin: *
/playground/*
  Access-Control-Allow-Origin: *
