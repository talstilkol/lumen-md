# חגים — נוצר מהתבנית תכנון חג
filters:
  and:
    - 'type == "holiday"'
properties:
  file.name:
    displayName: "תכנון"
  note.holiday:
    displayName: "חג"
  note.date:
    displayName: "תאריך"
  note.host:
    displayName: "מארח/ת"
views:
  - type: table
    name: "חגים"
    order:
      - file.name
      - note.holiday
      - note.date
      - note.host
    sort:
      - property: note.date
        direction: DESC
