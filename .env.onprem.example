# Lumen on-prem environment template (ε.3).
# Copy to .env.onprem and fill in your values, then:
#   docker compose --env-file .env.onprem up -d
#
# Skip optional services (e.g. billing if you don't sell Pro):
#   docker compose --env-file .env.onprem up -d --profile core

# ── Postgres password (used by collab + billing + audit) ────────────────────
LUMEN_PG_PASSWORD=changeme-strong-password-here

# ── Domain (display only; nginx serves all paths regardless) ────────────────
LUMEN_BASE_URL=https://lumen.example.com

# ── Collaboration (baked into the web build — rebuild lumen-web after edits) ─
# Public URLs browsers use to reach this stack's services (see the DNS notes
# in docker-compose.yml). Leave blank to fall back to public signaling and
# peer-to-peer only.
LUMEN_SIGNAL_URL=wss://signal.example.com
LUMEN_COLLAB_URL=wss://collab.example.com
# Access token for the persistent collab server (T49). Set it: without one
# anyone who can reach LUMEN_COLLAB_URL can open and write every room (the
# server warns at start). Generate with `openssl rand -hex 32` and enter the
# same value in each client under Collab settings → "Server access token".
LUMEN_COLLAB_TOKEN=
# Optional audit-log worker (edge-workers/audit).
LUMEN_AUDIT_URL=

# ── Web image size (plan 13.2) ──────────────────────────────────────────────
# full (default): the same-origin WebAssembly runtimes ship in the image
# (live-python / live-r / live-ruby blocks, OCR, local transcription; ≈145 MB).
# slim: without them — those features report "runtime not installed".
LUMEN_RUNTIMES=full

# ── Stripe (omit + drop `--profile billing` to skip billing entirely) ───────
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Sentry (optional — leave blank to disable telemetry) ────────────────────
SENTRY_DSN=

# ── WorkOS SSO (Enterprise, optional) ───────────────────────────────────────
WORKOS_API_KEY=
WORKOS_CLIENT_ID=

# ── OpenAI (server-side AI proxy — optional) ────────────────────────────────
# Lumen ships fully client-side AI by default; set this only if you want
# the on-prem stack to proxy AI requests for users without their own keys.
OPENAI_API_KEY=
