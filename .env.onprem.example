# Lumen on-prem environment template (ε.3).
# Copy to .env.onprem and fill in your values, then:
#   docker compose --env-file .env.onprem up -d
#
# Skip optional services (e.g. billing if you don't sell Pro):
#   docker compose --env-file .env.onprem up -d --profile core

# ── Postgres password (used by collab + billing + audit) ────────────────────
LUMEN_PG_PASSWORD=changeme-strong-password-here

# ── Domain (display only; nginx serves all paths regardless) ────────────────
LUMEN_BASE_URL=https://lumen.example.com

# ── Stripe (omit + drop `--profile billing` to skip billing entirely) ───────
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Sentry (optional — leave blank to disable telemetry) ────────────────────
SENTRY_DSN=

# ── WorkOS SSO (Enterprise, optional) ───────────────────────────────────────
WORKOS_API_KEY=
WORKOS_CLIENT_ID=

# ── OpenAI (server-side AI proxy — optional) ────────────────────────────────
# Lumen ships fully client-side AI by default; set this only if you want
# the on-prem stack to proxy AI requests for users without their own keys.
OPENAI_API_KEY=
