# Exclude only the genuinely-huge or irrelevant trees. The web build
# (tsc -b && vite build) type-checks src/__tests__, some of which import the
# small sibling service packages (mcp-server, marketplace-server) — so those
# are kept. node_modules is reinstalled by Vercel.
.git
node_modules
**/node_modules
dist
dist-ssr
coverage
playwright-report
test-results

# Native / desktop / mobile (src-tauri/target alone is ~1.1GB)
src-tauri
ios
android

# Separate Astro docs site (has its own node_modules + pagefind binary)
docs

# Not needed to type-check or bundle the SPA
e2e
.claude
*.log
*.local
