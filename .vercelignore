# Exclude only build outputs and local trees. The preview build runs the
# gates (W1.35: build, budget, vitest, i18n, hygiene, docs-sync, licences),
# and the tests read e2e/ specs, the docs pages, src-tauri/, ios/ and
# android/ configs: those sources ship (they are small; a local
# src-tauri/target is what used to be ~1.1GB). node_modules is reinstalled
# by Vercel.
.git
node_modules
**/node_modules
dist
dist-ssr
coverage
playwright-report
test-results

# Build outputs of the native / desktop / mobile and docs trees
src-tauri/target
src-tauri/gen
ios/App/Pods
ios/App/build
android/build
android/app/build
android/.gradle
docs/dist
docs/.astro

.claude
*.log
*.local
