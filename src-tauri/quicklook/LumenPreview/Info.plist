  <string>app.lumen.editor.preview</string>
  <key>CFBundleName</key>
  <string>Lumen Preview</string>
  <key>CFBundleExecutable</key>
  <string>LumenPreview</string>
  <key>CFBundlePackageType</key>
  <string>XPC!</string>
