<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the macOS bundle's Info.plist by Tauri. Plan W2.19: finding
     the other device on the local network (mDNS) needs the local network
     permission and the Bonjour service it browses for. -->
<plist version="1.0">
<dict>
  <key>NSLocalNetworkUsageDescription</key>
  <string>Lumen finds your other devices on this network and syncs with them directly, with no server.</string>
  <key>NSBonjourServices</key>
  <array>
    <string>_lumen-lan._tcp</string>
  </array>
  <!-- Plan W13.K2: Lumen's own file types, so Finder hands them to the Quick Look extension (and the app). -->
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>app.lumen.editor.excalidraw</string>
      <key>UTTypeDescription</key>
      <string>Excalidraw drawing</string>
      <key>UTTypeConformsTo</key>
      <array><string>public.json</string></array>
      <key>UTTypeTagSpecification</key>
      <dict><key>public.filename-extension</key><array><string>excalidraw</string></array></dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>app.lumen.editor.base</string>
      <key>UTTypeDescription</key>
      <string>Lumen base</string>
      <key>UTTypeConformsTo</key>
      <array><string>public.plain-text</string></array>
      <key>UTTypeTagSpecification</key>
      <dict><key>public.filename-extension</key><array><string>base</string></array></dict>
    </dict>
  </array>
  <key>UTImportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>net.daringfireball.markdown</string>
      <key>UTTypeDescription</key>
      <string>Markdown document</string>
      <key>UTTypeConformsTo</key>
      <array><string>public.plain-text</string></array>
      <key>UTTypeTagSpecification</key>
      <dict><key>public.filename-extension</key><array><string>md</string><string>markdown</string></array></dict>
    </dict>
  </array>
</dict>
</plist>
