cache=/tmp/lumen-npm-cache
# onnxruntime-node (a transitive dependency of @huggingface/transformers,
# unused in the browser build) would otherwise download CUDA binaries from
# nuget.org on every `npm ci`.
onnxruntime-node-install=skip
# W13.X6: no install scripts from dependencies (most npm attacks of 2025–2026 ran in postinstall).
# The few that are worth running are listed in scripts/supply/allow-scripts.json and run on purpose:
#   npm ci && npm run supply:allowed-scripts
ignore-scripts=true
