{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude,glob)*.md' ':(exclude,glob)docs/**' ':(exclude,glob)edge-workers/**' ':(exclude,glob)sync-server/**' ':(exclude,glob)mcp-server/**' ':(exclude,glob)api-server/**' ':(exclude,glob)marketplace-server/**' ':(exclude,glob)packages/**' ':(exclude,glob)extension/**' ':(exclude,glob)src-tauri/**' ':(exclude,glob)ios/**' ':(exclude,glob)android/**' ':(exclude,glob)e2e/**' ':(exclude,glob).github/**'",
  "rewrites": [
    {
      "source": "/((?!assets/|sw\\.js|workbox-|manifest|favicon|.*\\.[a-z0-9]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/playground/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/playground-runner.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self' blob: 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src * data: blob:; media-src * data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'none'; form-action 'none'"
        }
      ]
    }
  ]
}
