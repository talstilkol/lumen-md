{
  "name": "lumen-md",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Lumen — a hybrid markdown editor focused on world-class rendering and turning data into beautiful tables and charts.",
  "scripts": {
    "predev": "node scripts/copy-pyodide.mjs && node scripts/copy-webr.mjs && node scripts/copy-ruby.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-pyodide.mjs && node scripts/copy-webr.mjs && node scripts/copy-ruby.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "hygiene": "node scripts/check-code-hygiene.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:icons": "tauri icon public/favicon.svg",
    "ios:sync": "npm run build && npx cap sync ios",
    "ios:open": "npm run ios:sync && npx cap open ios",
    "ios:run": "npm run ios:sync && npx cap run ios",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npm run android:sync && npx cap open android",
    "test": "vitest run",
    "lumen": "tsx bin/lumen.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "budget": "node scripts/bundle-budget.mjs",
    "lighthouse": "lhci autorun --config=./lighthouserc.json",
    "lighthouse:a11y": "node scripts/lighthouse-a11y.mjs",
    "i18n:extract": "node scripts/extract-i18n-keys.mjs",
    "i18n:check": "node scripts/extract-i18n-keys.mjs --check",
    "docker:build": "docker build -t lumen-md .",
    "docker:run": "docker run -p 8080:8080 lumen-md"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "0.4.2",
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.6.2",
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/language": "^6.10.6",
    "@codemirror/language-data": "^6.5.1",
    "@codemirror/search": "^6.5.8",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.1",
    "@google/model-viewer": "^4.3.1",
    "@hpcc-js/wasm": "^2.33.2",
    "@isomorphic-git/lightning-fs": "^4.6.2",
    "@lezer/highlight": "^1.2.1",
    "@milkdown/core": "^7.20.0",
    "@milkdown/ctx": "^7.20.0",
    "@milkdown/plugin-clipboard": "^7.20.0",
    "@milkdown/plugin-history": "^7.20.0",
    "@milkdown/plugin-listener": "^7.20.0",
    "@milkdown/plugin-math": "^7.5.9",
    "@milkdown/plugin-slash": "^7.20.0",
    "@milkdown/plugin-tooltip": "^7.20.0",
    "@milkdown/preset-commonmark": "^7.20.0",
    "@milkdown/preset-gfm": "^7.20.0",
    "@milkdown/prose": "^7.20.0",
    "@milkdown/theme-nord": "^7.20.0",
    "@milkdown/transformer": "^7.20.0",
    "@milkdown/utils": "^7.20.0",
    "@mlc-ai/web-llm": "^0.2.82",
    "@replit/codemirror-vim": "^6.3.0",
    "@ruby/3.4-wasm-wasi": "2.10.1",
    "@ruby/wasm-wasi": "2.10.1",
    "@sentry/browser": "^10.50.0",
    "@sentry/react": "^10.50.0",
    "@tauri-apps/api": "^2.10.1",
    "abcjs": "^6.6.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.2.6",
    "echarts": "^6.1.0",
    "github-slugger": "^2.0.0",
    "idb-keyval": "^6.2.2",
    "isomorphic-git": "^1.37.5",
    "katex": "^0.16.11",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.58.0",
    "mdast-util-to-markdown": "^2.1.2",
    "mermaid": "^11.15.0",
    "papaparse": "^5.4.1",
    "pdfjs-dist": "^6.4.299",
    "prettier": "^3.9.10",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.41.8",
    "pyodide": "^314.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-react": "^8.0.0",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^3.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.1",
    "shiki": "^4.5.0",
    "sql.js": "^1.14.1",
    "tailwind-merge": "^2.5.5",
    "three": "^0.183.2",
    "tldraw": "^4.5.10",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "wasmoon": "^1.16.0",
    "webr": "^0.6.0",
    "y-codemirror.next": "^0.3.5",
    "y-protocols": "^1.0.7",
    "y-webrtc": "^10.3.0",
    "y-websocket": "^2.0.4",
    "yaml": "^2.6.1",
    "yjs": "^13.6.30",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tauri-apps/cli": "^2.10.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/leaflet": "^1.9.21",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.11.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.12",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "uuid": "^14.0.0"
  },
  "browserslist": [
    "defaults"
  ],
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
