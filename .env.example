# Copy this file to .env (or .env.local) and fill in your values.

# WebRTC signaling server for real-time collaboration.
# Default falls through to: wss://signal.lumen.md (Lumen-owned), then
# wss://signaling.yjs.dev (public fallback).
# Run your own with `cd sync-server && node server.js` and set this to
# ws://localhost:4444. Deploy to your own Fly.io app with
# `cd sync-server && fly launch && fly deploy` — uses the included
# Dockerfile + fly.toml.
VITE_WEBRTC_SIGNALING_URL=wss://signal.lumen.md

# Persistent collab server (y-websocket compatible). When set, every collab
# session also attaches a WebsocketProvider so docs survive when all peers
# leave the room. Run the server with:
#   cd sync-server && npm install y-websocket y-leveldb level
#   PORT=4444 node persistent-server.js
# then set this to ws://localhost:4444 (or wss://your-host in production).
VITE_YJS_WEBSOCKET_URL=

# Sentry error tracking. Leave blank to disable telemetry entirely.
# Format: https://<publicKey>@<host>/<projectId>
VITE_SENTRY_DSN=

# ── Lumen Cloud (optional) ─────────────────────────────────────────────────
# Set both to enable accounts (sign in / sign up / OAuth) and Pro features
# such as persistent collab rooms, cloud sync, and Smart search.
# Leave blank to keep Lumen fully local-first.
#
#   1. Create a free project at https://supabase.com.
#   2. Project Settings → API → copy the URL and anon key.
#   3. Run `npm install @supabase/supabase-js` (the SDK is dynamically
#      imported so it isn't bundled when missing).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Dropbox cloud sync (optional, P2-04) ───────────────────────────────────
# Create an app at https://www.dropbox.com/developers/apps with the
# "App folder" permission. Copy the App key here. Leave blank to hide the
# Dropbox sync UI entirely.
VITE_DROPBOX_APP_KEY=
# Optional — defaults to ${origin}/oauth/dropbox.
VITE_DROPBOX_REDIRECT=

# ── Google Drive cloud sync (optional, P2-04) ──────────────────────────────
# Create a Web OAuth client at https://console.cloud.google.com/apis/credentials.
# Add `${origin}/oauth/gdrive` to the authorized redirect URIs.
# The client secret is NOT used (PKCE flow); only the public client id is.
VITE_GDRIVE_CLIENT_ID=
# Optional — defaults to ${origin}/oauth/gdrive.
VITE_GDRIVE_REDIRECT=

# ── Billing edge endpoint (Stripe — P2-05) ─────────────────────────────────
# Set to your deployed Cloudflare Worker (see edge-workers/billing/).
VITE_BILLING_ENDPOINT=
# Set your real Stripe Price IDs (same currency / interval for both).
VITE_PRICE_ID_PRO=
VITE_PRICE_ID_TEAM=
# Optional entitlement endpoint for runtime plan sync from your backend.
VITE_ENTITLEMENT_ENDPOINT=

# ── Read-mode publishing endpoint (P3-08) ──────────────────────────────────
# Set to your deployed Cloudflare Worker (see edge-workers/publish/).
VITE_PUBLISH_ENDPOINT=
# Optional local fallback for development: when set, publish/unpublish use an
# in-browser mock store instead of requiring a real endpoint.
VITE_PUBLISH_MOCK_ENABLED=

# ── Plugin signature trust roots (optional) ────────────────────────────────
# JSON map of "fingerprint" => "base64-spki-public-key".
# Leave empty to rely only on user-trusted keys.
VITE_PLUGIN_TRUSTED_KEYS={}

# ── LanguageTool grammar (P3-12) ───────────────────────────────────────────
# Defaults to the public free endpoint. Self-host for higher rate limits.
VITE_LANGUAGETOOL_URL=
