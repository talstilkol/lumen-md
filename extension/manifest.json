{
  "manifest_version": 3,
  "name": "Lumen Web Clipper",
  "version": "0.2.0",
  "description": "Clip pages, selections and highlights into your Lumen vault as Markdown, with source and date.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Save to Lumen",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html"
}
