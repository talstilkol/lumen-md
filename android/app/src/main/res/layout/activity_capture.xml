<?xml version="1.0" encoding="utf-8"?>
<!-- Plan W11.P8 (Android): the native capture box the Quick Settings tile opens. start/end only, so Hebrew runs right to left. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="280dp"
    android:orientation="vertical"
    android:layoutDirection="locale"
    android:padding="16dp">

    <EditText
        android:id="@+id/capture_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minLines="3"
        android:gravity="top|start"
        android:textAlignment="viewStart"
        android:textDirection="anyRtl"
        android:inputType="textMultiLine|textCapSentences"
        android:importantForAutofill="no"
        android:hint="@string/capture_hint" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/capture_cancel"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/capture_cancel" />

        <Button
            android:id="@+id/capture_save"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/capture_save" />
    </LinearLayout>
</LinearLayout>
