# Lumen persistent collaboration server.
# Wraps `sync-server/persistent-server.js` (y-websocket + LevelDB storage)
# and exposes port 4445. There is no Postgres archive — LevelDB on the /data
# volume is the only persistence layer.

FROM node:22-alpine
WORKDIR /app

COPY sync-server/package.json sync-server/package-lock.json* ./
RUN npm ci --omit=dev || npm install --omit=dev

COPY sync-server/persistent-server.js sync-server/token.js ./

ENV NODE_ENV=production
ENV PORT=4445
EXPOSE 4445

# LevelDB persists under /data, which docker-compose mounts as a named
# volume. persistent-server.js reads YJS_STORAGE_DIR (LEVELDB_PATH is still
# accepted as a legacy alias).
VOLUME /data
ENV YJS_STORAGE_DIR=/data/yjs

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -q -O - http://localhost:4445/healthz > /dev/null || exit 1

CMD ["node", "persistent-server.js"]
