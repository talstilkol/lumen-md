# Lumen web shell — nginx serving the built SPA + a minimal CSP for self-hosted deployments.
# Usage: built and orchestrated via the repo-root docker-compose.yml.

# Multi-stage build: produce dist/ in stage 1 with the same toolchain CI uses,
# then copy into a slim nginx layer for the runtime image.
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci
COPY . .
# Deployment endpoints are baked in at build time (Vite) and added to the
# CSP connect-src. Pass them with `--build-arg` / compose `build.args`.
ARG VITE_WORKOS_ENDPOINT
ARG VITE_BILLING_ENDPOINT
ARG VITE_ENTITLEMENT_ENDPOINT
ARG VITE_PUBLISH_ENDPOINT
ARG VITE_AUDIT_ENDPOINT
ARG VITE_MARKETPLACE_URL
ARG VITE_LANGUAGETOOL_URL
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
RUN npm run build

FROM nginx:1.27-alpine
WORKDIR /usr/share/nginx/html

# Replace the default config with one that:
#   - serves dist/ root
#   - rewrites unknown routes to index.html (SPA)
#   - sets long-lived cache for hashed assets, no-store for index.html
#   - applies a Content-Security-Policy compatible with the app's runtime
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

COPY --from=build /app/dist .
# Fill in the deployment's worker origins (written by the Vite CSP plugin).
RUN extra="$(cat .csp-connect-extra 2>/dev/null | tr -d '\n')"; \
    sed -i "s#__CSP_CONNECT_EXTRA__#${extra}#" /etc/nginx/conf.d/default.conf && \
    rm -f .csp-connect-extra

EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD wget -q -O - http://localhost/ > /dev/null || exit 1

CMD ["nginx", "-g", "daemon off;"]
