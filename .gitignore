# Tauri
src-tauri/target/

# Capacitor — generated content + native build artifacts. We DO commit the
# Xcode / Android Studio project skeletons (so signing config + native
# tweaks are versioned), but skip everything that's regenerated on `cap
# sync`, downloaded by SPM/Gradle, or built locally.
ios/App/App/public/
ios/App/build/
ios/App/Pods/
ios/App/CapApp-SPM/.build/
ios/.DS_Store
android/app/build/
android/.gradle/
android/build/
android/local.properties
android/app/release/
android/app/src/main/assets/public/
**/xcuserdata/
**/*.xcworkspace/xcuserdata/
**/DerivedData/

# Environment
.env
.env.local

# Lighthouse CI reports
.lighthouseci/

# Test coverage reports — generated by `npm run test:coverage`
coverage/

# Claude Code session metadata — per-machine, not for the shared repo
.claude/
.vercel
public/pyodide/
public/webr/
public/ort/
public/quickjs/
public/ruby/
public/playground/vendor/
bundle-sizes.json
bundle-diff.md
.bundle-base/

# Live agent eval reports (npm run eval:agents)
eval/results/
flake-results/
visual-results/
# On-device OCR (scripts/copy-tesseract.mjs)
public/tesseract/
# Licence gate report — generated by `npm run licenses`
reports/

# Golden sets (plan 7.1): local-only data fetched by scripts/golden/hf_build.py fetch-local,
# and the held-out test split, which is only ever built in CI — never commit either.
eval/golden/*/local/
eval/golden/*/test/
