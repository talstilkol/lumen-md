.DS_Store

# Tauri
src-tauri/target/

# Capacitor — generated content + native build artifacts. We DO commit the
# Xcode / Android Studio project skeletons (so signing config + native
# tweaks are versioned), but skip everything that's regenerated on `cap
# sync`, downloaded by SPM/Gradle, or built locally.
ios/App/App/public/
ios/App/build/
ios/App/Pods/
ios/App/CapApp-SPM/.build/
ios/.DS_Store
android/app/build/
android/.gradle/
android/build/
android/local.properties
android/app/release/
# npm run mobile:ios works here: archive, export options, .ipa (plan W4.22)
/build/ios/
android/app/src/main/assets/public/
**/xcuserdata/
**/*.xcworkspace/xcuserdata/
**/DerivedData/

# Environment
.env
.env.local

# Lighthouse CI reports
.lighthouseci/

# Test coverage reports — generated by `npm run test:coverage`
coverage/

# Claude Code session metadata — per-machine, not for the shared repo
.claude/
.vercel
public/pyodide/
public/webr/
public/ort/
public/vad/
public/quickjs/
public/ruby/
public/playground/vendor/
bundle-sizes.json
bundle-diff.md
.bundle-base/

# Live agent eval reports (npm run eval:agents)
eval/results/
flake-results/
visual-results/
# Review triage / reply state (scripts/review-triage.mjs, review-reply.mjs)
/reports/*
# On-device OCR (scripts/copy-tesseract.mjs)
public/tesseract/
# On-device OCR (scripts/copy-tesseract.mjs). The language models in
# public/tesseract/lang/ are committed (tessdata_fast, Apache-2.0; plan 7.5).
public/tesseract/*
!public/tesseract/lang/
# Licence gate report — generated by `npm run licenses`
/reports/*
docs/dev/HANDOFF.md

# Golden sets (plan 7.1): local-only data fetched by scripts/golden/hf_build.py fetch-local,
# and the held-out test split, which is only ever built in CI — never commit either.
eval/golden/*/local/
eval/golden/*/test/

# Nightly / weekly reports (plan 0.11) — published as artifacts, never committed
/reports/*
.stryker-tmp/
.lighthouseci/
# Excalidraw canvas fonts (scripts/copy-excalidraw.mjs)
public/excalidraw/

# Reports written by the scheduled scripts (plan 0.11 / 14.3) — artifacts, never committed
/reports/*
# …except the sealed nightly reports (plan W4.36): committed receipts of what ran
!/reports/nightly/

# Signed release output and fuzzer findings (plan W1.27)
/release/
fuzz-findings/

# Plan 13.7: store screenshots are build output (node scripts/store-screenshots.mjs)
store/screenshots/
reports/

# Signed release output and fuzzer findings (plan W1.27)
/release/
fuzz-findings/
